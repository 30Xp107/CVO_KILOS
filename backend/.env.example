# KILOS Profiling API - environment variables
# Copy this file to backend/.env for local development.

# MongoDB Atlas connection string (or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/kilos_profiling

# Authentication secret - use a long random string in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial administrator. Automatically created on first sign-in when no admin exists.
ADMIN_NAME=KILOS Administrator
ADMIN_EMAIL=admin@kilos.local
ADMIN_PASSWORD=Admin@Kilos2026

# Comma-separated frontend origins allowed to call the API.
# localhost and 127.0.0.1 are different origins; list every origin you use.
# In production set this to your deployed frontend URL, e.g. https://kilos.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
